# Public URL of this MCP server as clients see it. Used as JWT audience, RFC 8707 resource and OAuth issuer.
MCP_URL=http://localhost:9100/mcp
# Bind address/port inside the container (compose maps 127.0.0.1:9100 -> 9100).
HOST=0.0.0.0
PORT=9100
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Authorized redirect URI must be exactly: http://localhost:9100/oauth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
# HMAC key for the access tokens THIS server issues (study only; production uses an asymmetric key + JWKS).
JWT_SECRET=change-me-to-a-long-random-string
