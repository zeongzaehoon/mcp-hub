# env/frontend-e2e.env — 브라우저 e2e(profile e2e) (추적됨). 순수 로컬 전용. 실 비밀번호는 env/secrets/frontend-e2e.env 가 덮는다.
E2E_FRONTEND=http://frontend:5173
E2E_API_PUBLIC=http://localhost:19000
E2E_API_INTERNAL=http://backend:8080
# ⚠ backend.env / secrets/backend.env 의 MASTER_EMAIL / MASTER_PASSWORD 와 반드시 동일
MASTER_EMAIL=master@example.com
MASTER_PASSWORD=master-dev-password-123
