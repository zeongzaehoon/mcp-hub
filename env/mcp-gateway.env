# env/mcp-gateway.env — mcp-gateway 전용 (추적됨, common.env 위에 겹친다). 시크릿 없음.

# ════════════ [ECS 에서도 주입] ════════════
# OAuth 2.1(API 키 동의) — ChatGPT / Claude.ai 커넥터가 접근하는 공개 URL. dev 는 nginx gateway(호스트 19000)가 /mcp 와
# OAuth 경로를 이 컨테이너(:9000)로 프록시한다(deploy/docker/gateway.nginx.conf.template). ECS: ALB 의 https 공개 주소.
GATEWAY_PUBLIC_URL=http://localhost:19000
# 서버종류=업스트림 MCP URL. 각 mcp-* 컨테이너의 PORT(compose 고정)와 맞아야 한다. ECS: Cloud Map 이름으로 교체.
GATEWAY_UPSTREAMS=postgres=http://mcp-postgres:9001/mcp,clickhouse=http://mcp-clickhouse:9002/mcp,mongo=http://mcp-mongo:9003/mcp,hacker=http://mcp-hacker:9004/mcp
# 회사 SSO: 동의 화면의 "회사 계정으로 로그인"이 backend 의 /api/v1/auth/sso/* 를 거친다. 서버 간 핸드오프 주소(ECS: backend 의 Cloud Map 이름).
GATEWAY_BACKEND_URL=http://backend:8080

# ════════════ [ECS 는 Secrets Manager 로] — dev 더미값. 실값은 env/secrets/mcp-gateway.env ════════════
# backend.env 의 SSO_HANDOFF_SECRET 과 같은 값. 비우면 동의 화면에서 SSO 항목이 사라진다.
SSO_HANDOFF_SECRET=change-me-dev-sso-handoff-secret-0123456789
