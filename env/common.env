# env/common.env — backend + 모든 mcp-* 컨테이너가 공유하는 환경변수 (추적됨, 로컬 dev 값).
# deploy/docker/docker-compose.yml 이 env_file 로 직접 소비한다. 실 시크릿은 env/secrets/common.env(gitignore, 키 목록은
# common.env.example)가 뒤에 겹쳐 같은 키를 덮는다. 기본값과 같은 값은 적지 않는다(코드 기본값이 진실: mcpcluster_common/settings.py,
# backend/app/core/config.py). TENANT_SECRET_KEY(_ENC)는 backend 와 MCP 서버가 같은 값을 써야 DSN 복호화가 맞으므로 컨테이너별로
# 쪼개지 않는다. (MCP 서버는 JWT 를 검증하지 않는다 — JWT_SECRET 은 콘솔 로그인용이고 MCP 서버에서는 dev 의 TENANT_SECRET_KEY 파생에만 쓰인다.)
# ⚠ docker compose 는 인라인 `# 주석`을 값에 포함시킨다 — 주석은 반드시 별도 줄에.

# ════════════ [ECS 에서도 주입] ════════════
# dev 에서만 TENANT_SECRET_KEY 를 JWT_SECRET 에서 파생하고 기본 시크릿을 허용한다. 운영은 반드시 dev 가 아닌 값(prod).
APP_ENV=dev
AWS_REGION=ap-northeast-2
# Redis: db1 authz 투영 / db2 캐시·rate / db3 접근로그 stream. 비밀번호는 여기 넣지 않는다 — REDIS_PASSWORD(redis.env)가 합성된다.
# ECS: ElastiCache 주소, TLS(rediss://). dev 가 아니면 비밀번호 없는 Redis 는 기동 거부.
REDIS_URL=redis://redis:6379
# PII 마스킹 (Rust mcpcluster_core: 이메일/전화/카드/주민번호)
REDACT_PII=1
# S3 산출물. 버킷 ftg-mcp 하나, 루트 mcp/ · control/ · audit/ (docs/S3_LAYOUT.md). dev 는 첫 사용 시 앱이 만든다(S3_MANAGE_BUCKET 기본 1).
# backend 도 이 값을 읽어 audit/ 에 접근 로그 parquet 을 쓴다. ECS: S3_ENDPOINT 는 비우고(실 S3) 자격은 IAM 역할 또는 Secrets Manager.
S3_BUCKET=ftg-mcp
S3_PUBLIC_ENDPOINT=http://localhost:9000
EXPORT_INLINE_MAX_BYTES=2000000
# compute: 이 행 수 이상은 Arrow(zero-copy)로 Rust 에 넘긴다
COMPUTE_ARROW_THRESHOLD_ROWS=20000
# 트레이싱: 비우면 꺼짐. OTLP/HTTP 수집기 URL (컨테이너 네트워크에서 접근 가능해야 함)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ════════════ [ECS 는 Secrets Manager 로] — 아래는 dev 더미값. 실값은 env/secrets/common.env ════════════
# 32바이트 이상: openssl rand -hex 32. dev 가 아니면 기본값·32바이트 미만은 backend 기동 거부.
JWT_SECRET=change-me-dev-jwt-secret
# Fernet 키(32 url-safe base64 바이트). dev 에서 비우면 JWT_SECRET 에서 파생. 키를 바꾸면 기존 암호화 DSN/자격증명을 읽을 수 없다.
TENANT_SECRET_KEY=
# dev 외 권장: KMS envelope. 생성: uv run --with boto3 python scripts/kms_wrap_key.py --key-id alias/ftg-app-data --endpoint http://localhost:8002
TENANT_SECRET_KEY_ENC=
# dev = aws-local MinIO root 계정. 운영은 버킷 한정 계정 또는 비워서 IAM 역할.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# ════════════ [로컬 전용 — ECS 주입 금지] ════════════
# ~/dev/aws-local 의 DynamoDB Local / MinIO / local-kms (external 네트워크 aws-local 의 별칭). ECS 는 태스크 IAM 역할을 쓴다 — 키를 넣지 말 것.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DYNAMO_ENDPOINT=http://dynamodb:8000
KMS_ENDPOINT=http://local-kms:8080
S3_ENDPOINT=http://minio:9000
# 모니터: dev 는 e2e 가 스케줄 실행을 관찰하도록 빠르게. 운영 기본(15s tick / 60s 최소 간격)은 코드 기본값.
MONITOR_TICK_S=2
MONITOR_MIN_INTERVAL_S=2
