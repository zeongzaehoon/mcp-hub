# env/mcp-clickhouse.env — mcp-clickhouse 전용 (추적됨, common.env 위에 겹친다). 순수 로컬 전용.
# ⚠ clickhouse.env 의 CLICKHOUSE_USER / CLICKHOUSE_PASSWORD 와 반드시 동일. 운영 datasource 는 콘솔 바인딩으로 — ECS 주입 없음.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=ch-dev-password
CLICKHOUSE_DEFAULT_DB=biz
