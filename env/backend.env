# env/backend.env — backend 전용 (추적됨, common.env 위에 겹친다). 실 시크릿은 env/secrets/backend.env 가 덮는다.
# ⚠ 주석은 별도 줄에(compose 는 인라인 주석을 값에 포함).

# ════════════ [ECS 에서도 주입] ════════════
# 마스터 계정 부트스트랩. ⚠ frontend-e2e.env 와 동일해야 한다. 호스트측 e2e 테스트도 이 dev 값을 가정한다.
MASTER_EMAIL=master@example.com
# 콘솔은 nginx gateway(19000)와 같은 origin 이라 CORS 가 필요 없다. 아래는 Vite 직접 접속·브라우저 e2e(frontend:5173)용. ECS 는 콘솔 origin 만.
CORS_ORIGINS=http://localhost:19000,http://localhost:5173,http://frontend:5173
# 회사 SSO(OIDC): 로그인 뒤 브라우저가 돌아갈 공개 주소. IdP 에 등록하는 redirect URI 는 CONSOLE_URL + /api/v1/auth/sso/callback.
# ECS: 둘 다 ALB 의 https 공개 주소.
CONSOLE_URL=http://localhost:19000
GATEWAY_PUBLIC_URL=http://localhost:19000
# 콘솔 헬스 체크 대상(내부 주소, 타입별 1개 + 게이트웨이). 서버 레코드의 공개 endpoint 는 쓰지 않는다. ECS: 서비스 디스커버리 이름.
MCP_INTERNAL_POSTGRES=http://mcp-postgres:9001
MCP_INTERNAL_CLICKHOUSE=http://mcp-clickhouse:9002
MCP_INTERNAL_MONGO=http://mcp-mongo:9003
MCP_INTERNAL_HACKER=http://mcp-hacker:9004
MCP_INTERNAL_GATEWAY=http://mcp-gateway:9000

# ════════════ [ECS 는 Secrets Manager 로] — dev 더미값. 실값은 env/secrets/backend.env ════════════
# dev 가 아니면 기본값·12자 미만은 기동 거부.
MASTER_PASSWORD=master-dev-password-123
# 게이트웨이가 SSO 세션 키를 받아갈 때 쓰는 공유 비밀(32자 이상). mcp-gateway.env 와 같은 값. 비우면 커넥터 SSO 비활성. 콘솔에는 SSO 로그인이 없다.
SSO_HANDOFF_SECRET=change-me-dev-sso-handoff-secret-0123456789
# 플랫폼 Google OAuth 클라이언트: Workspace 를 연결한 회사 직원의 커넥터 SSO 로그인용(스코프 openid·email·profile 뿐). 비우면 회사가 자체 OIDC 앱을 등록해야 한다.
# 운영: Google Cloud 콘솔에서 웹 클라이언트 생성, 승인된 리디렉션 URI = CONSOLE_URL/api/v1/auth/sso/callback. 실값은 env/secrets/backend.env
# 디렉터리 동기화는 이 클라이언트가 아니라 회사별로 콘솔에 등록하는 서비스 계정 키(도메인 전체 위임)로 돈다.
GOOGLE_CLIENT_ID=mock-google
GOOGLE_CLIENT_SECRET=mock-google-secret

# ════════════ [로컬 전용 — ECS 주입 금지] ════════════
# dev 는 Google 대신 mock-idp(compose profile mock-idp)의 /google 발급자를 쓴다. 운영은 기본값(accounts.google.com / admin.googleapis.com / oauth2.googleapis.com).
# mock 에는 Directory API 가 없어 dev 의 Workspace 동기화는 오류로 기록된다(실 Google 검증은 서비스 계정을 받은 뒤).
GOOGLE_ISSUER=http://mock-idp:8080/google
GOOGLE_DIRECTORY_URL=http://mock-idp:8080/google
GOOGLE_TOKEN_URL=http://mock-idp:8080/google/token
