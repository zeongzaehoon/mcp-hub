# env/secrets/common.env — backend + 모든 mcp-* 가 공유하는 실 시크릿. 로컬: 이 파일을 common.env 로 복사해 채운다(gitignore).
# 없어도 뜬다(compose required: false) — 그 경우 env/common.env 의 dev 더미값으로 기동하며, APP_ENV=dev 가 아니면 backend 가 기동을 거부한다.
# ECS 는 같은 키를 Secrets Manager 로 주입한다(docs/DEPLOY.md).

# 32바이트 이상: openssl rand -hex 32
JWT_SECRET=
# Fernet 키(32 url-safe base64 바이트). backend 와 MCP 서버가 같은 값이어야 DSN 복호화가 맞는다.
TENANT_SECRET_KEY=
# KMS envelope 로 감싼 TENANT_SECRET_KEY (scripts/kms_wrap_key.py). 둘 중 하나만.
TENANT_SECRET_KEY_ENC=
# S3 산출물 저장소 자격. 운영은 버킷 한정 계정 또는 비워서 IAM 역할.
S3_ACCESS_KEY=
S3_SECRET_KEY=
