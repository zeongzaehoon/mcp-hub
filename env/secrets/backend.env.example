# env/secrets/backend.env — backend 전용 실 시크릿. 로컬: 이 파일을 backend.env 로 복사해 채운다(gitignore).
# 마스터 계정 비밀번호. dev 가 아니면 기본값·12자 미만은 기동 거부. ⚠ frontend-e2e.env 와 동일해야 한다.
MASTER_PASSWORD=
# 게이트웨이와 공유하는 SSO 핸드오프 비밀(32자 이상, secrets/mcp-gateway.env 와 동일). openssl rand -hex 32
SSO_HANDOFF_SECRET=
# 플랫폼 Google OAuth 웹 클라이언트(Google Cloud 콘솔). 승인된 리디렉션 URI = CONSOLE_URL/api/v1/auth/sso/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
